---
import ItemPage from '../../../components/ItemPage.astro';
import { courseModules } from '../../../data/resources.js';

export function getStaticPaths() {
  return courseModules.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
---
<ItemPage item={item} items={courseModules} section="Online course" base="/resources/online-course" />
