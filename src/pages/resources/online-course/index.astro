---
import Base from '../../../layouts/Base.astro';
import Blocks from '../../../components/Blocks.astro';
import Crumbs from '../../../components/Crumbs.astro';
import { courseModules } from '../../../data/resources.js';

const items = courseModules.map((x) => ({ ...x, href: `/resources/online-course/${x.slug}` }));
---
<Base title="Online course" path="/resources/online-course">
  <section class="resources">
    <div class="wrap">
      <Crumbs trail={[{ label: 'Online course' }]} />
      <h2 class="title">Online course</h2>
      <Blocks items={items} cols={3} />
    </div>
  </section>
</Base>
