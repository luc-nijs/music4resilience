---
import Base from '../layouts/Base.astro';
---
<Base title="Team" path="/team">
  <section class="team">
    <div class="wrap">
      <h2 id="pis">Principal Investigators</h2>
      <div class="person">
        <img src="/images/team-potheini-vaiouli.jpg" alt="Potheini Vaiouli" loading="lazy">
        <div class="lines">
          <p class="name">Potheini Vaiouli</p>
          <p>Assistant Professor</p>
          <p>Department of Education and Social Work</p>
          <p class="bio">Background in music therapy and early childhood special education, with extensive experience as a practitioner, educator and researcher coordinating public outreach initiatives and research projects on the use of music to promote well-being.</p>
          <p><a href="https://www.uni.lu/fhse-en/people/potheini-vaiouli/" target="_blank" rel="noopener">UniLu webpage</a></p>
        </div>
      </div>
      <div class="person">
        <img src="/images/team-luc-nijs.jpg" alt="Luc Nijs" loading="lazy">
        <div class="lines">
          <p class="name">Luc Nijs</p>
          <p>Associate Professor in Early Childhood Music Education</p>
          <p>Department of Education and Social Work</p>
          <p class="bio">Background as teacher and researcher, focusing on innovative technologies and creativity. Supervisor of projects with vulnerable persons and co-founder of the Jonet Chair on Social Action and Music Making.</p>
          <p><a href="https://www.uni.lu/fhse-en/people/luc-nijs/" target="_blank" rel="noopener">UniLu webpage</a></p>
        </div>
      </div>
    </div>
  </section>
</Base>
