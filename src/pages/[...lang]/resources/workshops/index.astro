---
import Base from '../../../../layouts/Base.astro';
import Blocks from '../../../../components/Blocks.astro';
import Crumbs from '../../../../components/Crumbs.astro';
import { workshops } from '../../../../data/resources.js';
import { langPaths, href, pick } from '../../../../i18n.js';

export function getStaticPaths() { return langPaths(); }
const { lang } = Astro.props;
const title = pick(lang, { en: 'Workshops', fr: 'Ateliers', de: 'Workshops' });
const items = workshops(lang).map((x) => ({ ...x, href: href(lang, `/resources/workshops/${x.slug}`) }));
---
<Base title={title} path="/resources/workshops" lang={lang}>
  <section class="resources">
    <div class="wrap">
      <Crumbs lang={lang} trail={[{ label: title }]} />
      <h2 class="title">{title}</h2>
      <Blocks items={items} lang={lang} />
    </div>
  </section>
</Base>
