---
import Base from '../layouts/Base.astro';
---
<Base title="Partners" path="/partners">
  <section class="partners">
    <div class="wrap">
      <p class="intro" style="margin-top:30px">Music4Resilience is carried out together with organisations that work with young people every day. They help us reach youth workers, raise awareness, and bring the community music lab into their own practice.</p>
      <h2>Partners</h2>
      <div class="partner-grid">
        <div class="partner">
          <div class="logo"><span class="logo-text">FEDAS</span></div>
          <h3>FEDAS Luxembourg</h3>
          <p class="role">Recruitment &amp; awareness</p>
          <p>Federation of social and socio-educational service providers in Luxembourg. Supports the recruitment of participants and raises awareness of the project.</p>
          <a class="link" href="https://www.fedas.lu" target="_blank" rel="noopener">fedas.lu</a>
        </div>
        <div class="partner pink">
          <div class="logo"><span class="logo-text">Fondation EME</span></div>
          <h3>Fondation EME</h3>
          <p class="role">Recruitment &amp; awareness</p>
          <p>Brings music to people who have little access to it, such as people in hospitals, care homes and social institutions. Supports recruitment and raises awareness.</p>
          <a class="link" href="https://www.fondation-eme.lu" target="_blank" rel="noopener">fondation-eme.lu</a>
        </div>
        <div class="partner">
          <div class="logo"><span class="logo-text">Croix-Rouge luxembourgeoise</span></div>
          <h3>Croix-Rouge luxembourgeoise</h3>
          <p class="role">Recruitment &amp; implementation</p>
          <p>Recruits participants and implements the community music lab workshop content with youth workers in its organisation.</p>
          <a class="link" href="https://www.croix-rouge.lu" target="_blank" rel="noopener">croix-rouge.lu</a>
        </div>
      </div>
      <h2>Funding</h2>
      <div class="partner-grid">
        <div class="partner pink">
          <div class="logo"><span class="logo-text">André Losch Fondation</span></div>
          <h3>André Losch Fondation</h3>
          <p class="role">Funder</p>
          <p>Music4Resilience is supported by the André Losch Fondation (2026–2027).</p>
          <a class="link" href="https://www.loschfondation.lu" target="_blank" rel="noopener">loschfondation.lu</a>
        </div>
        <div class="partner">
          <div class="logo"><img src="/images/logo-unilu.jpg" alt="Université du Luxembourg"></div>
          <h3>University of Luxembourg</h3>
          <p class="role">Host institution</p>
          <p>Department of Education and Social Work, Belval Campus.</p>
          <a class="link" href="https://www.uni.lu" target="_blank" rel="noopener">uni.lu</a>
        </div>
      </div>
    </div>
  </section>
</Base>
