---
import '../styles/site.css';
import { nav } from '../data/nav.js';

interface Props { title: string; description?: string; path: string; noindex?: boolean }
const { title, description = 'Music4Resilience: community-based music labs that train and equip youth workers in Luxembourg to support vulnerable young people through music. A University of Luxembourg project supported by the André Losch Fondation.', path, noindex = false } = Astro.props;

const site = Astro.site ?? 'https://www.music4resilience.lu';
const canonical = new URL(path === '/' ? '/' : `${path}/`, site).href;
const fullTitle = path === '/' ? 'Music4Resilience | music & youth work' : `${title} | Music4Resilience`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="university of luxembourg, youth work, youth workers, music, mental health, well-being, resilience, inclusion, community music, music technology, André Losch Fondation" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Music4Resilience" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,300;0,6..12,400;0,6..12,700;0,6..12,800;1,6..12,300&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <p class="brand"><a href="/">Music<span class="four">4</span>Resilience</a></p>
      <p class="tagline">Building <em>Resilience</em> through <em>Music</em> in Youth Work</p>
      <nav class="menu" aria-label="Site">
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-list">Menu</button>
        <ul id="menu-list">
          {nav.map((item) => (
            <li><a href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <div class="rule"></div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="logos">
        <img src="/images/logo-unilu.jpg" alt="Université du Luxembourg" width="93" height="56" />
        <span class="logo-text">André Losch Fondation</span>
      </div>
      <p>Copyright © Université du Luxembourg 2026. All rights reserved</p>
    </footer>

    <script is:inline>
      // Phone menu: open and close the list.
      (function () {
        var b = document.querySelector('.menu-toggle');
        if (!b) return;
        b.addEventListener('click', function () {
          var open = b.getAttribute('aria-expanded') === 'true';
          b.setAttribute('aria-expanded', String(!open));
          document.querySelector('.menu').classList.toggle('open', !open);
        });
      })();
    </script>
  </body>
</html>
